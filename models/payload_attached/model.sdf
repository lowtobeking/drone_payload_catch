<?xml version="1.0"?>
<!--
  payload_attached —— 挂载型载荷（M6-moving 编队同速投放用）。

  与 models/payload 的区别：本模型带 gz DetachableJoint 插件，
  在收到 /payload/attach 后与 A 的 x500_0/base_link 形成固定关节，
  于是载荷随 A 一起飞行；收到 /payload/detach 后关节解除，
  载荷以**分离瞬间 A 的速度**自由下落（物理正确，继承水平速度）。

  坐标：Gazebo ENU；载荷 odom 发布到 /payload/odom（payload_node 转 NED）。
  机器人模型名固定为 A = x500_0（PX4 instance 0）。
-->
<sdf version="1.9">
  <model name="payload">
    <link name="link">
      <inertial>
        <mass>0.3</mass>
        <inertia><ixx>0.00018</ixx><iyy>0.00018</iyy><izz>0.00018</izz>
                 <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <collision name="collision">
        <geometry><box><size>0.06 0.06 0.06</size></box></geometry>
      </collision>
      <visual name="visual">
        <geometry><box><size>0.06 0.06 0.06</size></box></geometry>
        <material><ambient>0.9 0.5 0.1 1</ambient><diffuse>0.9 0.5 0.1 1</diffuse></material>
      </visual>
    </link>

    <plugin filename="gz-sim-odometry-publisher-system"
            name="gz::sim::systems::OdometryPublisher">
      <odom_topic>/payload/odom</odom_topic>
      <dimensions>3</dimensions>
    </plugin>

    <!-- 可分离挂载：parent=本载荷 link，child=A(x500_0)/base_link -->
    <plugin filename="gz-sim-detachable-joint-system"
            name="gz::sim::systems::DetachableJoint">
      <parent_link>link</parent_link>
      <child_model>x500_0</child_model>
      <child_link>base_link</child_link>
      <attach_topic>/payload/attach</attach_topic>
      <detach_topic>/payload/detach</detach_topic>
      <output_topic>/payload/detach_state</output_topic>
    </plugin>
  </model>
</sdf>
