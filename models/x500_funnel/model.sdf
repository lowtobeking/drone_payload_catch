<?xml version="1.0" encoding="UTF-8"?>
<!--
  x500_funnel —— B（接收机）模型：标准 x500 + 顶部刚性捕获漏斗。
  通过 PX4_GZ_MODEL_NAME 附着（先手动 create 本模型，再让 PX4 attach），
  这样不必改 PX4 模型树。

  几何（相对 model frame；x500_base 的 base_link 在 z=0.24，桨盘在 z≈0.30）：
    · funnel_link 在 z=0.38；宽口朝上的圆锥（roll=π），半径 0.20、长 0.14
      → 口平面 z≈0.45（≈ base_link 上方 0.21m），锥底(尖) z≈0.31，正好在桨盘之上。
    · 低恢复系数接触面 → 载荷落上去不弹飞。
-->
<sdf version='1.9'>
  <model name='x500_funnel'>
    <include merge='true'>
      <uri>model://x500</uri>
    </include>

    <link name="funnel_link">
      <pose>0 0 0.38 0 0 0</pose>
      <inertial>
        <mass>0.05</mass>
        <inertia>
          <ixx>2.0e-4</ixx><iyy>2.0e-4</iyy><izz>2.0e-4</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="funnel_collision">
        <pose>0 0 0 3.14159265 0 0</pose>
        <geometry>
          <cone><radius>0.20</radius><length>0.14</length></cone>
        </geometry>
        <surface>
          <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
          <bounce><restitution_coefficient>0.05</restitution_coefficient></bounce>
        </surface>
      </collision>
      <visual name="funnel_visual">
        <pose>0 0 0 3.14159265 0 0</pose>
        <geometry>
          <cone><radius>0.20</radius><length>0.14</length></cone>
        </geometry>
        <material>
          <ambient>0.15 0.55 0.85 1</ambient>
          <diffuse>0.15 0.55 0.85 1</diffuse>
        </material>
      </visual>
    </link>

    <joint name="funnel_joint" type="fixed">
      <parent>base_link</parent>
      <child>funnel_link</child>
    </joint>
  </model>
</sdf>
